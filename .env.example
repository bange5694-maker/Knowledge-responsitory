# 环境变量模板
# 用法：把本文件复制一份，改名为 .env（同目录），然后按下面的说明填写。
# 注意：settings.py 只在进程启动时读取 .env，改完必须重启 runserver 才生效。

# ---------- MySQL（必填）----------
DJANGO_MYSQL_DATABASE=dailyblog
DJANGO_MYSQL_USER=root
DJANGO_MYSQL_PASSWORD=这里填你自己的 MySQL 密码
DJANGO_MYSQL_HOST=127.0.0.1
DJANGO_MYSQL_PORT=3306

# ---------- 谷歌登录（不填则功能自动关闭）----------
DJANGO_GOOGLE_CLIENT_ID=
DJANGO_GOOGLE_CLIENT_SECRET=

# ---------- GitHub 登录（不填则功能自动关闭）----------
DJANGO_GITHUB_CLIENT_ID=
DJANGO_GITHUB_CLIENT_SECRET=
