@startuml
skinparam monochrome true
skinparam shadowing false
hide footbox
autonumber

actor "访客" as User
boundary "搜索页界面" as UI <<边界类>>
control "搜索控制器" as Ctrl <<控制类>>
entity "搜索索引" as EIndex <<实体类>>
entity "文章" as EArticle <<实体类>>

User -> UI : 输入关键词并提交搜索
UI -> Ctrl : 提交搜索(keyword)
activate Ctrl
Ctrl -> EIndex : 检索索引(keyword)
EIndex --> Ctrl : 匹配的文档编号
Ctrl -> EArticle : 加载文章(编号列表)
EArticle --> Ctrl : 文章信息（标题/摘要/分类）
Ctrl --> UI : 搜索结果（标题高亮）
deactivate Ctrl
UI -> User : 展示搜索结果
@enduml
